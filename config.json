{
  "log_file": "logs/watchdog.log",
  "send_text": "continue",
  "responses": {
    "cyber_policy": "continue",
    "usage_limit_exceeded": "continue",
    "context_window_exceeded": "/compact"
  },
  "watch_codes": [
    "cyber_policy",
    "usage_limit_exceeded",
    "context_window_exceeded"
  ],
  "delivery": "queue",
  "sendkeys_fallback": false,
  "per_thread_max": 3,
  "per_thread_window_min": 5,
  "per_thread_pause_min": 15,
  "delay_s": 3,
  "cooldown_s": 0,
  "max_burst": 0,
  "burst_window_min": 10,
  "pause_after_limit_min": 15,
  "require_terminal_foreground": true,
  "terminals": [
    "WindowsTerminal",
    "conhost",
    "cmd",
    "powershell",
    "pwsh",
    "Code",
    "alacritty",
    "wezterm-gui",
    "mintty"
  ],
  "dry_run": false
}
